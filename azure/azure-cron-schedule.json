{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "subscriptionId": {
      "type": "String",
      "metadata": {
        "description": "Azure Subscription ID for container group execution"
      }
    },
    "resourceGroup": {
      "type": "String",
      "defaultValue": "rg-walmart-scraper-prod",
      "metadata": {
        "description": "Azure Resource Group containing the container group"
      }
    },
    "containerGroupName": {
      "type": "String",
      "defaultValue": "aci-walmart-scraper-job",
      "metadata": {
        "description": "Azure Container Group instance name"
      }
    }
  },
  "triggers": {
    "Recurrence_Twice_Weekly": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Week",
        "interval": 1,
        "schedule": {
          "days": [
            "Sunday",
            "Wednesday"
          ],
          "hours": [
            "4"
          ],
          "minutes": [
            0
          ]
        },
        "timeZone": "UTC"
      }
    }
  },
  "actions": {
    "Start_Azure_Container_Instance": {
      "type": "Http",
      "inputs": {
        "method": "POST",
        "uri": "https://management.azure.com/subscriptions/@{parameters('subscriptionId')}/resourceGroups/@{parameters('resourceGroup')}/providers/Microsoft.ContainerInstance/containerGroups/@{parameters('containerGroupName')}/start?api-version=2023-05-01",
        "authentication": {
          "type": "ManagedServiceIdentity"
        }
      }
    }
  }
}
